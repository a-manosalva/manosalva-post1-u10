{
  "info": {
    "_postman_id": "be84e544-4abd-4a2f-97da-0a6ce9a16e45",
    "name": "API Catálogo de Productos",
    "description": "Pruebas de extremo a extremo para el API de productos. Requiere que la aplicación esté ejecutándose.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST Crear producto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201 Created\", () => {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Respuesta contiene id numérico\", () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property(\"id\");",
              "    pm.expect(body.id).to.be.a(\"number\");",
              "    pm.collectionVariables.set(\"productoId\", body.id);",
              "});",
              "pm.test(\"Tiempo de respuesta < 500ms\", () => {",
              "    pm.expect(pm.response.responseTime).to.be.below(500);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Teclado mecánico\",\n  \"precio\": 120.0,\n  \"categoria\": \"ELECTRONICA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET Obtener producto creado",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 OK\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"El nombre coincide con el creado\", () => {",
              "    pm.expect(pm.response.json().nombre).to.eql(\"Teclado mecánico\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productos/{{productoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos",
            "{{productoId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET Listar por categoría",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 OK\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"La categoría incluye el producto creado\", () => {",
              "    const productos = pm.response.json();",
              "    pm.expect(productos.some((producto) => producto.id === Number(pm.collectionVariables.get(\"productoId\")))).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productos?categoria=ELECTRONICA",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ],
          "query": [
            {
              "key": "categoria",
              "value": "ELECTRONICA"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET Producto inexistente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 404 Not Found\", () => {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productos/99999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos",
            "99999"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "productoId",
      "value": "",
      "type": "string"
    }
  ]
}
